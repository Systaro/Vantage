# ── Databases ────────────────────────────────────────────────────────────────────────────────
# Owner roles run migrations; the hub runs as vantage_hub (RLS), the worker as vantage_worker (BYPASSRLS).
HUB_MIGRATE_URL=postgres://vantage_owner:vantage_dev@127.0.0.1:5460/vantage
HUB_DATABASE_URL=postgres://vantage_hub:vantage_dev@127.0.0.1:5460/vantage
WORKER_DATABASE_URL=postgres://vantage_worker:vantage_dev@127.0.0.1:5460/vantage
OPS_MIGRATE_URL=postgres://vantage_ops:vantage_dev@127.0.0.1:5460/vantage_ops
OPS_DATABASE_URL=postgres://vantage_ops:vantage_dev@127.0.0.1:5460/vantage_ops
# Tests create throwaway databases with this superuser connection (dev only).
PG_ADMIN_URL=postgres://postgres:vantage_dev@127.0.0.1:5460/postgres

# ── Hub ──────────────────────────────────────────────────────────────────────────────────────
HUB_PORT=7100
HUB_PUBLIC_URL=http://localhost:7100
# Test reports are served from a second origin so their scripts never run next to the session cookie.
REPORTS_URL=http://127.0.0.1:7100
# Long random strings. HUB_SECRET encrypts TOTP and channel secrets at rest and signs report URLs.
HUB_SECRET=change-me-dev-only-hub-secret-0123456789abcdef
STORAGE_DIR=./data/storage

# Connections to the clusters and the mail relay are configured in Vantage (Verwaltung →
# Integrationen). These variables only seed them: on start the worker copies them into the
# integrations table once, and from then on only what is saved there counts.
LOGS_ES_URL=http://127.0.0.1:5461
LOGS_ES_AUTH=
APM_ES_URL=http://127.0.0.1:5461
APM_ES_AUTH=
# PEM file of the CA behind a self-signed cluster certificate.
APM_ES_CA_FILE=
SMTP_URL=smtp://127.0.0.1:5462
MAIL_FROM=Vantage <vantage@localhost>

LOGS_INDEX_PREFIXES=logstash-
# APM 7.x index patterns (rollover indices or data stream aliases), read-only.
APM_ERROR_INDEX=apm-*-error-*
APM_TRANSACTION_INDEX=apm-*-transaction-*
# Per-request timeout for both clusters.
ES_TIMEOUT_MS=15000

# ── Ops ──────────────────────────────────────────────────────────────────────────────────────
OPS_PORT=7101
OPS_PUBLIC_URL=http://localhost:7101
OPS_SECRET=change-me-dev-only-ops-secret-0123456789abcdef
# Where ops posts events, and the token an admin created for it in the hub (Admin → Tokens).
OPS_HUB_URL=http://localhost:7100
OPS_HUB_EVENT_TOKEN=
# Run logs (runs/<id>.log, kept 90 days). In production a persistent volume.
OPS_DATA_DIR=./data/ops
# The Ansible project. Dev: a harmless localhost example (cp -R test/fixtures/ansible data/ansible-example).
# Production: the ansible-configs checkout, with ANSIBLE_GIT_PULL=true to `git pull --ff-only` before each run.
ANSIBLE_PROJECT_DIR=./data/ansible-example
ANSIBLE_GIT_PULL=false
# GitLab for pipeline triggers (scheduled test runs).
GITLAB_URL=https://gitlab.com
# Optional overrides: ANSIBLE_PLAYBOOK_BIN (default ansible-playbook), OPS_GIT_BIN (git), OPS_SSH_BIN (ssh).

# Behind a reverse proxy: take the client IP from X-Forwarded-For (rightmost TRUST_PROXY_HOPS entries).
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
