# The Vantage runner (docs/design.md 6.7): runs inside a customer network, only connects out.
#   docker run -d --restart unless-stopped --env-file runner.env -v vantage-runner:/data <image>
# It carries the probe code and the host agent, nothing of the hub: no database code, no UI.
FROM oven/bun:1.3.14-alpine
RUN apk add --no-cache openssh-client
WORKDIR /app
ENV NODE_ENV=production
COPY package.json tsconfig.json ./
COPY src/runner src/runner
COPY src/shared/runner-protocol.ts src/shared/runner-protocol.ts
COPY src/shared/hosts src/shared/hosts
COPY src/hub/modules/uptime/probes.ts src/hub/modules/uptime/health.ts src/hub/modules/uptime/
COPY agent/vantage-agent.sh agent/vantage-agent.sh
ARG VERSION=dev
ENV VANTAGE_RUNNER_VERSION=$VERSION VANTAGE_RUNNER_DATA=/data
RUN mkdir -p /data && chown bun:bun /data
USER bun
VOLUME /data
CMD ["bun", "run", "src/runner/index.ts"]
