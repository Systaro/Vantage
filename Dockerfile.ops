# Ops (internal only): Bun + Ansible + SSH. Never exposed to customers; see docs/ops.md.
#   ops:     bun run src/ops/index.tsx      (port 7101)
#   migrate: bun run src/shared/migrate-cli.ts ops
# Mount the ansible-configs checkout at ANSIBLE_PROJECT_DIR, the SSH key for the central sweep at
# /home/bun/.ssh, and a volume at /data/ops for run logs.
FROM oven/bun:1.3.14-alpine AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM oven/bun:1.3.14-alpine
RUN apk add --no-cache ansible openssh-client git curl
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules node_modules
COPY package.json tsconfig.json ./
COPY src/shared src/shared
COPY src/ops src/ops
COPY agent agent
COPY public public
COPY scripts/create-ops-admin.ts scripts/create-ops-admin.ts
RUN mkdir -p /data/ops /home/bun/.ssh && chown -R bun:bun /data/ops /home/bun/.ssh && chmod 700 /home/bun/.ssh
ENV OPS_DATA_DIR=/data/ops
USER bun
EXPOSE 7101
CMD ["bun", "run", "src/ops/index.tsx"]
